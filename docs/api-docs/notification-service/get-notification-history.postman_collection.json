          "code": 200,
          "body": "[\n  {\n    \"id\": \"65abc123def456\",\n    \"type\": \"EMAIL\",\n    \"subject\": \"Order Confirmation\",\n    \"status\": \"DELIVERED\",\n    \"createdAt\": \"2026-02-05T10:00:00Z\",\n    \"readAt\": null\n  },\n  {\n    \"id\": \"65abc123def789\",\n    \"type\": \"SMS\",\n    \"subject\": \"Shipping Update\",\n    \"status\": \"SENT\",\n    \"createdAt\": \"2026-02-04T15:30:00Z\",\n    \"readAt\": \"2026-02-04T16:00:00Z\"\n  }\n]"
