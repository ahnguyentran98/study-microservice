{
  "info": {
    "name": "Get Payment API",
    "description": "Get payment details by order ID",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get Payment by Order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/123",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "payments", "123"]
        },
        "description": "Get payment details by order ID"
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"id\": 789,\n  \"orderId\": 123,\n  \"userId\": 456,\n  \"amount\": 99.99,\n  \"currency\": \"USD\",\n  \"status\": \"SUCCESS\",\n  \"transactionId\": \"ch_xxx\",\n  \"createdAt\": \"2026-02-05T10:01:00Z\"\n}"
        },
        {
          "name": "Not Found",
          "status": "Not Found",
          "code": 404,
          "body": "{\n  \"error\": \"Payment not found\"\n}"
        }
      ]
    }
  ]
}
