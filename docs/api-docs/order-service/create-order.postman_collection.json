{
  "info": {
    "name": "Create Order API",
    "description": "Create a new order with multiple items",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"items\": [\n    {\n      \"productId\": 101,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 102,\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": \"123 Main St, City, State 12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "orders"]
        },
        "description": "Create a new order with multiple items"
      },
      "response": [
        {
          "name": "Success",
          "status": "Created",
          "code": 201,
          "body": "{\n  \"id\": 1,\n  \"userId\": 1,\n  \"status\": \"PENDING\",\n  \"totalAmount\": 299.97,\n  \"items\": [\n    {\n      \"productId\": 101,\n      \"productName\": \"Wireless Headphones\",\n      \"quantity\": 2,\n      \"unitPrice\": 99.99,\n      \"subtotal\": 199.98\n    }\n  ],\n  \"shippingAddress\": \"123 Main St, City, State 12345\",\n  \"createdAt\": \"2026-02-05T10:00:00Z\"\n}"
        },
        {
          "name": "Insufficient Inventory",
          "status": "Conflict",
          "code": 409,
          "body": "{\n  \"error\": \"Insufficient inventory for product 101\"\n}"
        },
        {
          "name": "User Not Found",
          "status": "Not Found",
          "code": 404,
          "body": "{\n  \"error\": \"User not found\"\n}"
        }
      ]
    }
  ]
}
