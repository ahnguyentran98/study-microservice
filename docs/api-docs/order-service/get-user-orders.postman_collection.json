          "body": "[\n  {\n    \"id\": 1,\n    \"userId\": 1,\n    \"status\": \"DELIVERED\",\n    \"totalAmount\": 299.97,\n    \"itemCount\": 3,\n    \"createdAt\": \"2026-01-15T10:00:00Z\"\n  },\n  {\n    \"id\": 2,\n    \"userId\": 1,\n    \"status\": \"PAID\",\n    \"totalAmount\": 149.99,\n    \"itemCount\": 1,\n    \"createdAt\": \"2026-02-01T14:30:00Z\"\n  }\n]"
        }
